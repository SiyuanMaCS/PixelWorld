{
  "protocol": "pixelworld-physics-iq-v2",
  "inputs_root": "data/physics_iq/inputs",
  "runs_root": "runs",
  "max_concurrency": 4,
  "max_per_config": 2,
  "max_attempts": 2,
  "models": [
    {
      "key": "openai-example",
      "model": "gpt-5.4",
      "reasoning_effort": "high",
      "provider": {
        "type": "builtin"
      },
      "tracks": [
        "text",
        "vision-agent"
      ]
    },
    {
      "key": "responses-gateway-example",
      "model": "your-model-id",
      "reasoning_effort": "high",
      "provider": {
        "type": "responses",
        "id": "my-responses-gateway",
        "name": "My Responses gateway",
        "base_url": "https://api.example.com/v1",
        "env_key": "MY_RESPONSES_API_KEY"
      },
      "tracks": [
        "text",
        "vision-agent"
      ]
    }
  ]
}
